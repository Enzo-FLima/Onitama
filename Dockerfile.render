# Imagem única para o Render: servidor Java (porta 8080, interna) + Caddy (porta $PORT, pública)
# servindo o front-end e encaminhando /ws para o Java. O Render fornece o HTTPS.

FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /app
COPY Onitama/pom.xml .
RUN mvn -q dependency:go-offline
COPY Onitama/src ./src
RUN mvn -q compile dependency:copy-dependencies -DoutputDirectory=target/lib

FROM eclipse-temurin:21-jre
COPY --from=caddy:2-alpine /usr/bin/caddy /usr/bin/caddy
WORKDIR /app
COPY --from=build /app/target/classes ./classes
COPY --from=build /app/target/lib ./lib
COPY FrontEnd /srv
COPY Caddyfile /etc/caddy/Caddyfile
ENV BACKEND_ADDR=localhost:8080
EXPOSE 10000
CMD ["sh", "-c", "java -cp 'classes:lib/*' Enzo.lima.ServidorOnitama 8080 & SITE_ADDRESS=\":${PORT:-10000}\" exec caddy run --config /etc/caddy/Caddyfile --adapter caddyfile"]

